# Jira Host URL (Cloud or Data Center)
JIRA_HOST=https://jira.yourcompany.com

# For Jira Data Center (PAT authentication): leave JIRA_EMAIL commented out/empty.
# For Jira Cloud (Basic authentication): uncomment and fill JIRA_EMAIL.
# JIRA_EMAIL=user@company.com

# Jira API Token (or Personal Access Token for Data Center)
JIRA_API_TOKEN=your-api-token-or-pat
